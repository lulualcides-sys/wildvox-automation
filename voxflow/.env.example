DATABASE_URL=postgresql://user:password@localhost:5432/voxflow
PUBLIC_BASE_URL=https://your-domain.example

# Social sign-in + YouTube OAuth (same Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Publishing integrations
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Secure OAuth token storage
TOKEN_ENCRYPTION_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=VoxFlow <no-reply@your-domain.example>

# Mercado Pago billing
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Render worker / S3-compatible storage (Cloudflare R2, S3, etc.)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
WORKER_POLL_SECONDS=8
